load("//build/kernel/kleaf:kernel.bzl", "ddk_module")
load("//msm-kernel:soc_modules.bzl", "soc_modules")

package(default_visibility = ["//visibility:public"])

# The NXP driver consumes get_nfc_id from this stock Oplus provider.
ddk_module(
    name = "sun_perf_oplus_nfc",
    srcs = ["oplus_nfc.c", "oplus_nfc.h"],
    out = "oplus_nfc.ko",
    deps = ["//msm-kernel:all_headers"] + soc_modules(["//vendor/oplus/kernel/boot:oplus_bsp_boot_projectinfo"]),
    kernel_build = "//msm-kernel:sun_perf",
)
